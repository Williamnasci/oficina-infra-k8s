# Copie para terraform.tfvars e ajuste. Nao commitar terraform.tfvars (ja esta no .gitignore).

aws_region    = "us-east-1"
instance_type = "t3.small"
cluster_name  = "oficina"

# Vazio por padrao — acesso operacional real e via SSM Session Manager, nao SSH.
ssh_allowed_cidr_blocks = [
  # "203.0.113.10/32",
]

# 0.0.0.0/0 por padrao: o trafego real do cliente final passa pelo API Gateway,
# nao direto nessas portas. Restrinja se preferir expor menos superficie.
app_allowed_cidr_blocks = ["0.0.0.0/0"]
